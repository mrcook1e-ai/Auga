<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <!-- Пути к Valheim и BepInEx -->
  <Import Project="..\Valheim.props" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{BCC7DD31-D943-4684-800E-176A97DDDB8F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Auga</RootNamespace>
    <AssemblyName>Auga</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'API|AnyCPU'">
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <AssemblyName>AugaAPI</AssemblyName>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <OutputPath>bin\API\</OutputPath>
    <DefineConstants>API;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx core -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
    </Reference>

    <!-- APIManager (положи APIManager.dll в папку Libs\) -->
    <Reference Include="APIManager">
      <HintPath>..\Libs\APIManager.dll</HintPath>
    </Reference>

    <!-- Valheim assemblies — публикуются автоматически через BepInEx.AssemblyPublicizer.MSBuild -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManagedDir)\assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <!-- assembly_steamworks переименован в новых версиях Valheim -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ValheimManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)\assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <!-- ui_lib переименован в gui_framework в новых версиях Valheim -->
    <Reference Include="gui_framework">
      <HintPath>$(ValheimManagedDir)\gui_framework.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>

    <!-- UnityEngine — берём из valheim_Data\Managed (там полные, нестриппнутые) -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManagedDir)\Unity.TextMeshPro.dll</HintPath>
    </Reference>

    <!-- Локальные зависимости -->
    <Reference Include="fastJSON">
      <HintPath>..\Libs\fastJSON.dll</HintPath>
    </Reference>

    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="API.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="API.Common.cs" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
    <Compile Include="Auga.cs" />
    <Compile Include="MovableHudElement.cs" />
    <Compile Include="AugaLog_Hooks.cs" />
    <Compile Include="Chat_Setup.cs" />
    <Compile Include="Connection_Setup.cs" />
    <Compile Include="DamageText_Setup.cs" />
    <Compile Include="Extensions.cs" />
    <Compile Include="GuiBar_Patch.cs" />
    <Compile Include="Hud_Setup.cs" />
    <Compile Include="LastHitTracker.cs" />
    <Compile Include="MainMenu_Setup.cs" />
    <Compile Include="MessageHud_Setup.cs" />
    <Compile Include="PauseMenu_Setup.cs" />
    <Compile Include="PlayerInventory_Setup.cs" />
    <Compile Include="Settings_Setup.cs" />
    <Compile Include="SetupHelper.cs" />
    <Compile Include="Store_Setup.cs" />
    <Compile Include="TextInput_Setup.cs" />
    <Compile Include="EnemeyHud_Setup.cs" />
    <Compile Include="TextViewer_Setup.cs" />
    <Compile Include="Text_Patch.cs" />
    <Compile Include="UITooltip_Patch.cs" />
    <Compile Include="Minimap_Setup.cs" />
    <Compile Include="Barber_Setup.cs" />
    <Compile Include="Compat\Chatter.cs" />
    <Compile Include="Compat\Jewelcrafting.cs" />
    <Compile Include="Compat\SearsCatalog.cs" />
    <Compile Include="SkillsDialog_Patch.cs" />
    <Compile Include="Utilities\TranspilerHelpers.cs" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
    <None Include="manifest.json" />
    <None Include="packages.config" />
    <None Include="README.md" />
    <None Include="translations.json" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
    <EmbeddedResource Include="..\AugaUnity\AssetBundles\augaassets">
      <Link>augaassets</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
    <EmbeddedResource Include="..\AugaUnityLib\bin\Debug\Unity.Auga.dll">
      <Link>Unity.Auga.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
    <ProjectReference Include="..\AugaUnityLib\AugaUnityLib.csproj">
      <Project>{5b19eb03-f699-46bc-afaf-2a2e78e1f6c5}</Project>
      <Name>AugaUnityLib</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
    <EmbeddedResource Include="..\Libs\fastJSON.dll">
      <Link>fastJSON.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ILRepack.targets" />
    <EmbeddedResource Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' " Include="..\Libs\APIManager.dll">
      <Link>APIManager.dll</Link>
    </EmbeddedResource>
    <Content Include="..\CHANGELOG.md">
      <Link>CHANGELOG.md</Link>
    </Content>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- AssemblyPublicizer.MSBuild — автоматически публикует Valheim assemblies -->
  <Import Project="..\packages\BepInEx.AssemblyPublicizer.MSBuild.0.4.2\build\BepInEx.AssemblyPublicizer.MSBuild.targets"
          Condition="Exists('..\packages\BepInEx.AssemblyPublicizer.MSBuild.0.4.2\build\BepInEx.AssemblyPublicizer.MSBuild.targets')" />

  <!-- ILRepack — объединяет зависимости в одну DLL -->
  <Import Project="..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2\build\ILRepack.Lib.MSBuild.Task.targets"
          Condition="Exists('..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2\build\ILRepack.Lib.MSBuild.Task.targets')" />

  <!-- Копирование скомпилированного мода в папку плагинов Valheim -->
  <Target Name="Copy" AfterTargets="ILRepack">
    <Exec Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' "
          Command="xcopy &quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(ValheimPluginsDir)\$(ProjectName)\&quot; /q /y /i" />
    <Exec Condition=" '$(Configuration)|$(Platform)' == 'API|AnyCPU' "
          Command="xcopy &quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(SolutionDir)Libs\AugaAPI\&quot; /q /y /i" />
  </Target>

  <PropertyGroup>
    <PostBuildEvent Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
      xcopy "$(ProjectDir)translations.json" "$(ValheimPluginsDir)\$(ProjectName)\" /q /y /i
    </PostBuildEvent>
  </PropertyGroup>

  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>NuGet пакет отсутствует: {0}. Выполни "Restore NuGet Packages" в Visual Studio.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('..\packages\ILRepack.Lib.MSBuild.Task.2.0.18.2\build\ILRepack.Lib.MSBuild.Task.targets')"
           Text="$([System.String]::Format('$(ErrorText)', 'ILRepack.Lib.MSBuild.Task.2.0.18.2'))" />
    <Error Condition="!Exists('..\packages\BepInEx.AssemblyPublicizer.MSBuild.0.4.2\build\BepInEx.AssemblyPublicizer.MSBuild.targets')"
           Text="$([System.String]::Format('$(ErrorText)', 'BepInEx.AssemblyPublicizer.MSBuild.0.4.2'))" />
  </Target>

</Project>
